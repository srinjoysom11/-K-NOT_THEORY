/-
  Lean42.Delta -- Delta-moves and the equivalence of polygons.

  Phase 1 of research/exact/lean42/PLAN.md.  Sources: Burde-Zieschang, Knots (2nd ed.), Chapter 1,
  section B: Definition 1.6 (Delta-move), the Remark after it (degenerate triangles are allowed as
  long as the new polygon stays simple), Definition 1.7 (combinatorial equivalence = finite sequence
  of Delta and Delta^{-1} moves).  Lickorish, Chapter 1, uses the same notion.
  Proposition 1.10 (equivalence with PL isotopy) is only quoted in the paper; it is not used here.

  Definition 1.6 in our terms.  Let `P` be a simple polygon and `[a,b]` one of its edges.  Let `c`
  be a point such that the closed triangle `abc` meets `P` exactly in `[a,b]`.  Replacing the edge
  `[a,b]` by the two edges `[a,c]`, `[c,b]` gives a polygon `Q`; if `Q` is again simple, `P → Q` is a
  Delta-move and `Q → P` is an inverse Delta-move.  The picture is a thin tent over the edge: the
  triangle is free of the rest of the knot, so the tent can be pushed across it without crossing
  the knot.  If `c` lies on `[a,b]` the triangle is degenerate, and the move only inserts a vertex
  into a straight edge (or removes one): this is the "bisection" of the Remark.
  Since polygons are cyclic lists, the edge is placed first by a cyclic rotation (a generator of
  `Equiv`, below); `DeltaMove P Q` is then "P = a :: b :: R and Q = a :: c :: b :: R".

  `Equiv` is generated by
    * Delta-moves,
    * `rotate`: the cyclic rotation of the list of vertices (same point set, same edges),
    * `reverse`: the reversed list (same point set; we study unoriented knots),
    * `translate`: the translation of all vertices by a vector.
  Rotation and reversal do not change the subset of Q^3 at all.  Translation is the isotopy
  `x ↦ x + s t`, `0 ≤ s ≤ 1`; by Burde-Zieschang Prop. 1.10 (proof of (1) => (3), Figure 1.6) it
  is a composite of Delta-moves, so `Equiv` is the same relation as Delta-equivalence.  We do not
  prove that here: the equivalence relation of the theorems is `Equiv` as defined, and a statement
  "no lattice polygon is `Equiv` to ..." is *stronger* the more pairs are related; hence adding
  the translations makes the lower-bound theorems stronger, never weaker.  (The only thing later
  phases must check is that every invariant is unchanged by translation, which is clear for
  diagrams.)  `Equiv` is reflexive on every list, but all its uses are for simple polygons.
-/
import Lean42.Polygon

namespace Lean42

/-- A Delta-move at the first edge of the polygon (Burde-Zieschang Definition 1.6 and Remark). -/
def DeltaMove (P Q : List Pt) : Prop :=
  ∃ (a b c : Pt) (R : List Pt), P = a :: b :: R ∧ Q = a :: c :: b :: R ∧
    Simple P ∧ Simple Q ∧ tri a b c ∩ pset P = seg a b

/-- The generating relation of `Equiv`. -/
inductive Step : List Pt → List Pt → Prop
  | delta {P Q : List Pt} : DeltaMove P Q → Step P Q
  | rot (P : List Pt) : Step P (P.rotate 1)
  | rev (P : List Pt) : Step P P.reverse
  | trans (P : List Pt) (t : Pt) : Step P (P.map (· + t))

/-- Equivalence of polygons (Burde-Zieschang Definition 1.7, plus the trivial moves above). -/
def Equiv (P Q : List Pt) : Prop := Relation.EqvGen Step P Q

namespace Equiv
theorem refl (P : List Pt) : Equiv P P := Relation.EqvGen.refl P
theorem symm {P Q : List Pt} (h : Equiv P Q) : Equiv Q P := Relation.EqvGen.symm _ _ h
theorem trans {P Q S : List Pt} (h : Equiv P Q) (h' : Equiv Q S) : Equiv P S :=
  Relation.EqvGen.trans _ _ _ h h'
theorem of_step {P Q : List Pt} (h : Step P Q) : Equiv P Q := Relation.EqvGen.rel _ _ h
theorem of_delta {P Q : List Pt} (h : DeltaMove P Q) : Equiv P Q := of_step (Step.delta h)
theorem rotate (P : List Pt) (k : ℕ) : Equiv P (P.rotate k) := by
  induction k with
  | zero => simp [refl]
  | succ k ih =>
    refine ih.trans ?_
    rw [← List.rotate_rotate]
    exact of_step (Step.rot _)
theorem reverse (P : List Pt) : Equiv P P.reverse := of_step (Step.rev P)
theorem translate (P : List Pt) (t : Pt) : Equiv P (P.map (· + t)) := of_step (Step.trans P t)
end Equiv

/-- A Delta-move is determined by the freedom of the triangle: if every point of the triangle
    `abc` that lies on `P` lies on `[a,b]`, then `tri a b c ∩ pset P = seg a b`. -/
theorem deltaMove_mk {a b c : Pt} {R : List Pt} (hP : Simple (a :: b :: R))
    (hQ : Simple (a :: c :: b :: R))
    (h : ∀ x, x ∈ tri a b c → x ∈ pset (a :: b :: R) → x ∈ seg a b) :
    DeltaMove (a :: b :: R) (a :: c :: b :: R) := by
  refine ⟨a, b, c, R, rfl, rfl, hP, hQ, ?_⟩
  ext x
  constructor
  · rintro ⟨hx1, hx2⟩; exact h x hx1 hx2
  · intro hx
    refine ⟨seg_subset_tri_ab a b c hx, ?_⟩
    refine ⟨(a, b), ?_, hx⟩
    rw [edges_cons_cons]; simp

/-! ## Transport along injective affine maps -/

theorem pset_map {φ : Pt → Pt} (hφ : IsAffInj φ) (L : List Pt) :
    pset (L.map φ) = φ '' pset L := by
  ext x
  simp only [pset, edges_map, List.mem_map, Set.mem_setOf_eq, Set.mem_image]
  constructor
  · rintro ⟨e', ⟨e, he, rfl⟩, hx⟩
    simp only [Prod.map] at hx
    rw [← hφ.seg_image] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact ⟨y, ⟨e, he, hy⟩, rfl⟩
  · rintro ⟨y, ⟨e, he, hy⟩, rfl⟩
    refine ⟨Prod.map φ φ e, ⟨e, he, rfl⟩, ?_⟩
    simp only [Prod.map]
    rw [← hφ.seg_image]
    exact ⟨y, hy, rfl⟩

theorem Simple.map {φ : Pt → Pt} (hφ : IsAffInj φ) {L : List Pt} (h : Simple L) :
    Simple (L.map φ) := by
  obtain ⟨h3, hnd, hp⟩ := h
  refine ⟨by simpa using h3, hnd.map hφ.injective, ?_⟩
  intro e he e' he' hne
  rw [edges_map] at he he'
  obtain ⟨f, hf, rfl⟩ := List.mem_map.1 he
  obtain ⟨f', hf', rfl⟩ := List.mem_map.1 he'
  have hfne : f ≠ f' := fun h => hne (by rw [h])
  have hok := hp f hf f' hf' hfne
  intro x hx hx'
  simp only [Prod.map] at hx hx' ⊢
  rw [← hφ.seg_image] at hx hx'
  obtain ⟨y, hy, rfl⟩ := hx
  obtain ⟨y', hy', hyy⟩ := hx'
  have := hφ.injective hyy
  subst this
  have h1 := hok y hy hy'
  simp only [hφ.injective.eq_iff]
  exact h1

theorem DeltaMove.map {φ : Pt → Pt} (hφ : IsAffInj φ) {P Q : List Pt} (h : DeltaMove P Q) :
    DeltaMove (P.map φ) (Q.map φ) := by
  obtain ⟨a, b, c, R, rfl, rfl, hP, hQ, hT⟩ := h
  refine ⟨φ a, φ b, φ c, R.map φ, by simp, by simp, hP.map hφ, hQ.map hφ, ?_⟩
  have h1 : (a :: b :: R).map φ = φ a :: φ b :: R.map φ := by simp
  rw [← h1, pset_map hφ, ← hφ.tri_image, ← hφ.seg_image, ← Set.image_inter hφ.injective, hT]

theorem Step.map {φ : Pt → Pt} (hφ : IsAffInj φ) {P Q : List Pt} (h : Step P Q) :
    Step (P.map φ) (Q.map φ) := by
  cases h with
  | delta h => exact Step.delta (h.map hφ)
  | rot P => rw [← List.map_rotate]; exact Step.rot _
  | rev P => rw [← List.map_reverse]; exact Step.rev _
  | trans P t =>
    obtain ⟨M, t0, hM, hφ'⟩ := hφ
    have : (P.map (· + t)).map φ = (P.map φ).map (· + M t) := by
      simp only [List.map_map]
      apply List.map_congr_left
      intro x _
      simp [Function.comp, hφ', map_add]
      abel
    rw [this]
    exact Step.trans _ _

/-- Equivalence is preserved by every injective affine map (lattice symmetries, mirror image,
    translations): it maps Delta-moves to Delta-moves, and the other generators to themselves. -/
theorem Equiv.map {φ : Pt → Pt} (hφ : IsAffInj φ) {P Q : List Pt} (h : Equiv P Q) :
    Equiv (P.map φ) (Q.map φ) := by
  induction h with
  | rel x y hxy => exact Equiv.of_step (hxy.map hφ)
  | refl x => exact Equiv.refl _
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2

/-- The mirror image `(x, y, z) ↦ (x, y, -z)`. -/
def mirror (x : Pt) : Pt := ![x 0, x 1, -x 2]

theorem isAffInj_mirror : IsAffInj mirror := by
  refine ⟨{ toFun := mirror, map_add' := ?_, map_smul' := ?_ }, 0, ?_, ?_⟩
  · intro x y; ext i; fin_cases i <;> simp [mirror] <;> ring
  · intro c x; ext i; fin_cases i <;> simp [mirror]
  · intro x y h
    have h0 := congrFun h 0
    have h1 := congrFun h 1
    have h2 := congrFun h 2
    simp [mirror] at h0 h1 h2
    ext i; fin_cases i <;> simp [h0, h1, h2]
  · intro x; simp

/-- Equivalence of two polygons up to mirror image. -/
def EquivMirror (P Q : List Pt) : Prop := Equiv P Q ∨ Equiv P (Q.map mirror)

end Lean42
